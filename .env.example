# Copy to .env and fill in. Never commit a real .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
# Used only when DB_ENGINE=postgres
DB_NAME=examlock
DB_USER=examlock
DB_PASSWORD=examlock
DB_HOST=localhost
DB_PORT=5432

# Redis (optional locally). If unset, cache falls back to local memory.
REDIS_URL=redis://localhost:6379/0

# Celery: set CELERY_EAGER=0 when a real broker/worker is running (docker-compose).
CELERY_EAGER=1
